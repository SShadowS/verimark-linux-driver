+static void
+synatlsmoc_send_next_led_frame (FpiDeviceSynaTlsMoc *self);
+
+static void
+recv_kensington_led_frame (FpDevice *device,
+                           guint8   *buffer_in,
+                           gsize     length_in,
+                           GError   *error)
+{
+  FpiDeviceSynaTlsMoc *self = FPI_DEVICE_SYNATLSMOC (device);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  self->led_sequence_index++;
+  if (self->led_sequence_index < self->led_sequence_length)
+    synatlsmoc_send_next_led_frame (self);
+  else
+    {
+      self->led_sequence_index = 0;
+      self->led_sequence_length = 0;
+      fpi_ssm_next_state (self->task_ssm);
+    }
+}
+
+static void
+synatlsmoc_send_next_led_frame (FpiDeviceSynaTlsMoc *self)
+{
+  guint8 command[KENSINGTON_LED_EX2_COMMAND_SIZE];
+
+  g_assert (self->led_sequence_index < self->led_sequence_length);
+  kensington_transport_build_led_ex2 (command, self->led_sequence_event);
+  synatlsmoc_exec_cmd (self, FALSE, TRUE, command, sizeof (command),
+                       SENSOR_FW_REPLY_STATUS_HEADER_LEN,
+                       recv_kensington_led_frame);
+}
+
+static void
+synatlsmoc_start_led_sequence (FpiDeviceSynaTlsMoc *self,
+                               KensingtonLedEvent   event,
+                               guint                frame_count)
+{
+  g_assert (synatlsmoc_uses_kensington_transport (self));
+  g_assert (frame_count > 0);
+  g_assert (self->led_sequence_length == 0);
+
+  self->led_sequence_index = 0;
+  self->led_sequence_length = frame_count;
+  self->led_sequence_event = event;
+  synatlsmoc_send_next_led_frame (self);
+}
