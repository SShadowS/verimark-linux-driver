+static gboolean
+load_persistent_data_file (FpiDeviceSynaTlsMoc *self,
+                           const gchar         *path,
+                           GError             **error)
+{
+  g_autofree gchar *contents = NULL;
+  gsize length = 0;
+  struct stat statbuf;
+
+  if (!g_path_is_absolute (path))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                           "Persistent pairing path must be absolute");
+      return FALSE;
+    }
+  if (g_lstat (path, &statbuf) != 0)
+    {
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+                   "Cannot inspect persistent pairing file: %s",
+                   g_strerror (errno));
+      return FALSE;
+    }
+  if (!S_ISREG (statbuf.st_mode) || statbuf.st_uid != geteuid () ||
+      (statbuf.st_mode & 0777) != 0600)
+    {
+      g_set_error_literal (
+          error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+          "Persistent pairing file must be regular, owner-only mode 0600, "
+          "and owned by the service user");
+      return FALSE;
+    }
+  if (!g_file_get_contents (path, &contents, &length, error))
+    return FALSE;
+
+  return fp_device_set_persistent_data (FP_DEVICE (self),
+                                        (guchar *) contents, length, error);
+}
