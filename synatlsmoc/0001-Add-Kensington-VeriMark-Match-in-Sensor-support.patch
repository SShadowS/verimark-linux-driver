+static void
+cancel_cleanup_data_free (CancelCleanupData *data)
+{
+  g_clear_error (&data->action_error);
+  g_free (data);
+}
+
+static void
+synatlsmoc_cancel_cleanup_run_state (FpiSsm  *ssm,
+                                     FpDevice *device)
+{
+  FpiDeviceSynaTlsMoc *self = FPI_DEVICE_SYNATLSMOC (device);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case CANCEL_CLEANUP_EVENT_MASK_NONE:
+      send_event_config (self, NO_EVENTS);
+      break;
+    case CANCEL_CLEANUP_FRAME_FINISH:
+      if (self->frame_active)
+        sensor_frame_finish (self);
+      else
+        fpi_ssm_next_state (ssm);
+      break;
+    case CANCEL_CLEANUP_ENROLL_FINISH:
+      if (self->enroll_active)
+        send_enroll_finish (self);
+      else
+        fpi_ssm_next_state (ssm);
+      break;
+    case CANCEL_CLEANUP_COMPLETE:
+      fpi_ssm_mark_completed (ssm);
+      break;
+    }
+}
+
+static void
+synatlsmoc_cancel_cleanup_done (FpiSsm  *ssm,
+                                FpDevice *device,
+                                GError   *error)
+{
+  FpiDeviceSynaTlsMoc *self = FPI_DEVICE_SYNATLSMOC (device);
+  CancelCleanupData *data = fpi_ssm_get_data (ssm);
+  g_autoptr (GError) cleanup_error = error;
+  g_autoptr (GError) action_error = g_steal_pointer (&data->action_error);
+
+  g_assert (self->task_ssm == ssm);
+  self->task_ssm = NULL;
+  self->cleanup_active = FALSE;
+  self->frame_active = FALSE;
+  self->enroll_active = FALSE;
+
+  if (cleanup_error)
+    fp_warn ("Sensor cleanup after action failure did not complete: %s",
+             cleanup_error->message);
+
+  fpi_device_action_error (device, g_steal_pointer (&action_error));
+}
+
+static void
+synatlsmoc_start_cancel_cleanup (FpiDeviceSynaTlsMoc *self,
+                                 GError              *action_error)
+{
+  CancelCleanupData *data = g_new0 (CancelCleanupData, 1);
+
+  data->action_error = action_error;
+  self->cleanup_active = TRUE;
+  self->task_ssm = fpi_ssm_new_full (
+      FP_DEVICE (self), synatlsmoc_cancel_cleanup_run_state,
+      CANCEL_CLEANUP_NUM_STATES, CANCEL_CLEANUP_NUM_STATES,
+      "Cancel cleanup");
+  fpi_ssm_set_data (self->task_ssm, data,
+                    (GDestroyNotify) cancel_cleanup_data_free);
+  fpi_ssm_start (self->task_ssm, synatlsmoc_cancel_cleanup_done);
 }
 
